{
  "name": "callback-hackathon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "node --check src/worker.js && node --check src/demo.js && node --check public/app.js && node --check public/engine.js",
    "index:demo": "node scripts/index-demo.mjs",
    "test:production": "node scripts/production-check.mjs",
    "test:cold": "node scripts/cold-check.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "automation:connect": "node scripts/connect-automation.mjs",
    "automation:render": "node scripts/render-broadcast.mjs",
    "automation:broadcast": "node scripts/broadcast-and-clip.mjs",
    "automation:media": "node scripts/download-owned-media.mjs",
    "automation:record": "node scripts/record-live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "wrangler": "^4.156.0"
  }
}
