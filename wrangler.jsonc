{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callback-hackathon",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "durable_objects": { "bindings": [{ "name": "STUDIO", "class_name": "Studio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Studio"] }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
